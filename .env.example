# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

CHECKOUT_MONGODB_URI=mongodb://127.0.0.1:27017/sachhay_checkout?replicaSet=rs0
CHECKOUT_PORT=8788
ADMIN_SESSION_CHECK_URL=http://127.0.0.1:8787/api/admin-session.php
# Generate a random secret of at least 32 characters. Keep it on the server.
CHECKOUT_JWT_SECRET=

# VietQR stays disabled until the SePay webhook secret is configured.
VIETQR_BANK_BIN=970457
VIETQR_ACCOUNT_NUMBER=
VIETQR_ACCOUNT_NAME=
VIETQR_TEMPLATE=compact2
SEPAY_WEBHOOK_SECRET=

# Public details for the Phước Tân store. Leave unknown values blank.
VITE_STORE_STREET=
VITE_STORE_PHONE=
VITE_STORE_EMAIL=nguyenthinhphuc294@gmail.com
VITE_STORE_HOURS=
